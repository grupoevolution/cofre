# ---------- Obrigatório ----------
APP_PIN=1234
DATA_DIR=/data

# ---------- Bunny Storage (pastas com fotos e vídeos) ----------
# Painel Bunny → Storage → sua zona → "FTP & API Access"
BUNNY_STORAGE_ZONE=nome-da-zona
BUNNY_STORAGE_KEY=senha-da-zona
# Região principal da zona (ex.: São Paulo = br.storage.bunnycdn.com; Frankfurt = storage.bunnycdn.com)
BUNNY_STORAGE_HOST=br.storage.bunnycdn.com
# Opcional: Pull Zone ligada ao Storage, para o sistema mostrar o link público de cada arquivo
BUNNY_STORAGE_CDN=https://seu-pullzone.b-cdn.net

# ---------- Bunny Stream (pastas só de vídeo) ----------
# Painel Bunny → Stream → sua biblioteca → API
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_KEY=chave-da-biblioteca

# ---------- Travas para não sobrecarregar a VPS ----------
DOWNLOAD_CONCURRENCY=3      # arquivos baixando ao mesmo tempo (no total, somando todas as pastas)
UPLOAD_CONCURRENCY=2        # envios ao Bunny ao mesmo tempo
FFMPEG_CONCURRENCY=1        # edições/miniaturas ao mesmo tempo
FFMPEG_THREADS=2            # núcleos de CPU que cada edição pode usar
MIN_FREE_GB=2               # abaixo disso de espaço livre, downloads e edições pausam sozinhos
STALL_TIMEOUT_SEC=60        # download parado por mais que isso é cancelado e tentado de novo

# Opcional: só se o erome passar a exigir login/age-gate
# EROME_COOKIE=
