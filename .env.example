# PIN de acesso (obrigatório: sem ele o Cofre fica bloqueado)
APP_PIN=1234
APP_SECRET=troque-por-um-texto-aleatorio-longo
DATA_DIR=/data

# ---- Bunny (envio manual pelo botão "Enviar pro Bunny") ----
# Storage zone + senha dela (Bunny → Storage → zona → FTP & API Access → Password)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Endereço da Pull Zone ligada a essa storage (ex.: https://minhazona.b-cdn.net)
BUNNY_CDN_URL=
# Só se a zona não for de Falkenstein (ex.: br.storage.bunnycdn.com, ny.storage.bunnycdn.com)
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Pasta raiz dentro da zona (os arquivos vão para cofre/<pasta escolhida>/...)
BUNNY_BASE_DIR=cofre

# ---- Opcionais ----
# Só se o erome passar a exigir login/age-gate. Copie o cookie do navegador do celular.
# EROME_COOKIE=
# Sites que pedem login: use a aba "Contas" no app (cola o cookies.txt ou o JSON do Cookie-Editor)
# Arquivos em paralelo por álbum / downloads ao mesmo tempo
FILE_CONCURRENCY=3
ALBUM_CONCURRENCY=2
# Máximo de arquivos por link (perfil/playlist gigante)
MAX_PER_LINK=300
# Tira câmera/GPS/data dos arquivos ao baixar (0 = desliga)
STRIP_METADATA=1
# Atualiza yt-dlp e gallery-dl sozinho 1x por dia (0 = desliga)
AUTO_UPDATE_ENGINES=1

# ---- Proxy (para sites que bloqueiam o servidor, ex.: YouTube) ----
# Ex.: proxy residencial http://usuario:senha@host:porta
# PROXY_URL=
# fallback = só usa quando o site bloquear (padrão) · always = tudo pelo proxy
# PROXY_MODE=fallback

# ---- Navegador invisível (último recurso) ----
# 0 = desliga. Cada uso gasta ~200-400 MB de memória por até 1 minuto.
BROWSER_FALLBACK=1
BROWSER_TIMEOUT_SEC=60

# ---- Legendas automáticas (modelo de visão no próprio servidor) ----
# 0 = desliga. Usa ~0,5–1 GB de RAM enquanto analisa; baixa o modelo (~150 MB) 1x para /data/models
AUTO_TAGS=1
